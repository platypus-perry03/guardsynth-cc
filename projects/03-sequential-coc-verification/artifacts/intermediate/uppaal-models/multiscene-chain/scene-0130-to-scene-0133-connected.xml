    <location id="m2" x="220" y="320">
      <name x="200" y="290">ActiveAccel</name>
      <label kind="invariant" x="200" y="340">obligation_clock &lt;= DEADLINE</label>
    </location>
    <location id="m3" x="460" y="260">
      <name x="440" y="230">Responded</name>
    </location>
    <location id="m4" x="460" y="420">
      <name x="440" y="390">Miss</name>
    </location>
    <init ref="m0" />
    <transition>
      <source ref="m0" />
      <target ref="m1" />
      <label kind="synchronisation" x="0" y="0">slow_req?</label>
      <label kind="assignment" x="0" y="20">active_intent = 1, obligation_clock = 0</label>
    </transition>
    <transition>
      <source ref="m0" />
      <target ref="m2" />
