    <location id="m0" x="0" y="260">
      <name x="-20" y="230">Idle</name>
    </location>
    <location id="m1" x="220" y="200">
      <name x="200" y="170">ActiveSlow</name>
      <label kind="invariant" x="200" y="220">obligation_clock &lt;= DEADLINE</label>
