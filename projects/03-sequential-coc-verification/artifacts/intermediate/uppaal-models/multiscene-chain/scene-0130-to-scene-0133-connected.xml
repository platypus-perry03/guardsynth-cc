      <label kind="assignment" x="0" y="20">deadline_miss = true</label>
    </transition>
    <transition>
      <source ref="m4" />
      <target ref="m4" />
    </transition>
  </template>
  <system>Source = ChainSource();
MonitorProc = Monitor();
system Source, MonitorProc;</system>
