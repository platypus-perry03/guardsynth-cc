\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{kiee-review}[2026/08/05 KIEE 2022 anonymous review format]

\RequirePackage{fontspec}
\RequirePackage[a4paper,left=18.01mm,right=18.01mm,top=18.99mm,bottom=18.99mm,
  headsep=10mm,footskip=10mm]{geometry}
\RequirePackage{amsmath,amssymb}
\RequirePackage{booktabs}
\RequirePackage{tabularx}
\RequirePackage{graphicx}
\RequirePackage{float}
\IfFileExists{placeins.sty}{\RequirePackage{placeins}}{}
\RequirePackage{xcolor}
\RequirePackage{tikz}
\RequirePackage{url}
\RequirePackage{xspace}
\RequirePackage{listings}
\RequirePackage{caption}
\RequirePackage[hidelinks]{hyperref}

% The font files and OFL license are bundled so the review PDF is reproducible.
\setmainfont[
  Path=fonts/,
  Extension=.otf,
  UprightFont=*-Regular,
  BoldFont=*-Bold
]{NotoSerifCJKkr}
\setsansfont[
  Path=fonts/,
  Extension=.otf,
  UprightFont=*-Regular,
  BoldFont=*-Bold
]{NotoSerifCJKkr}

\setlength{\columnsep}{8mm}
\setlength{\parindent}{1em}
\setlength{\parskip}{0pt}
\newcommand{\kieebodyfont}{\fontsize{8.5pt}{12.75pt}\selectfont}

\definecolor{safe}{RGB}{40,120,90}
\definecolor{guard}{RGB}{40,95,160}
\definecolor{warning}{RGB}{180,120,35}
\definecolor{unsafe}{RGB}{165,55,55}
\definecolor{neutral}{RGB}{70,70,70}
