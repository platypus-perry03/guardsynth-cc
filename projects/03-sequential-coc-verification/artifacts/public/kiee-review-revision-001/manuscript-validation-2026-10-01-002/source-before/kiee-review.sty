\usetikzlibrary{arrows.meta,positioning,fit,shapes.geometric,calc}
\definecolor{observed}{RGB}{40,120,90}
\definecolor{derived}{RGB}{40,95,160}
\definecolor{assumed}{RGB}{180,120,35}
